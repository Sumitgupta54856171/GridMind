# ==============================================================================
# GRIDMIND BACKEND API ENVIRONMENT TEMPLATE (backend/.env)
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Database Connection (MongoDB)
# Local instance or MongoDB Atlas connection string:
MONGODB_URI=mongodb://localhost:27017/gridmind_dev

# Authentication Security (JWT)
# Must be a cryptographically secure random string with at least 32 characters
JWT_SECRET=super_secret_jwt_key_sample_must_be_at_least_32_characters_long_12345
JWT_EXPIRES_IN=7d

# Microservice & Client URLs
FASTAPI_URL=http://localhost:8000
CLIENT_URL=http://localhost:5173

# Optional Fireworks AI API key if forwarded directly by backend
FIREWORKS_API_KEY=fw_sample_fireworks_api_key_xxxxxxxxxxxxxxxxxxxxxxxx
