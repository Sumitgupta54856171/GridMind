# ==============================================================================
# GRIDMIND PLATFORM — MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# This template contains all required environment variables and secrets needed
# to run the GridMind platform (Backend, Frontend, and FastAPI AI Microservice).
#
# INSTRUCTIONS:
# 1. Duplicate this file or the respective sub-service .env.example files:
#      cp .env.example .env
#      cp backend/.env.example backend/.env
#      cp fastapi/.env.example fastapi/.env
#      cp frontend/.env.example frontend/.env
# 2. Replace the placeholder fake values below with your actual credentials.
# 3. NEVER commit your actual .env files containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE.JS / EXPRESS BACKEND API (backend/.env)
# ------------------------------------------------------------------------------
# Network port where the Node.js / Express API gateway will listen
PORT=3001

# Node execution environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI (Local instance or MongoDB Atlas cluster connection string)
# Example local: mongodb://localhost:27017/gridmind_db
# Example Atlas: mongodb+srv://db_admin:FakePassword123@cluster0.abcde.mongodb.net/gridmind_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gridmind_dev

# JWT Secret Key used to sign and verify authentication tokens (minimum 32 characters)
JWT_SECRET=super_secret_jwt_key_sample_must_be_at_least_32_characters_long_12345

# JWT Token Expiration Window (e.g., 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# Internal URL where the backend routes AI requests to the FastAPI Python service
# Local default: http://localhost:8000 | Production Render: https://gridmind-1-idck.onrender.com
FASTAPI_URL=https://gridmind-1-idck.onrender.com

# CORS Allowed Origin for frontend web client requests
# Local default: http://localhost:5173 | Production Netlify: https://gridmindai23.netlify.app
CLIENT_URL=https://gridmindai23.netlify.app

# ------------------------------------------------------------------------------
# 2. FASTAPI PYTHON AI SERVICE (fastapi/.env)
# ------------------------------------------------------------------------------
# Network host and port for the FastAPI Uvicorn ASGI server
HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG=True
ENVIRONMENT=development

# Express API Gateway URL for internal callback or health checks
# Local default: http://localhost:3001 | Production Render: https://gridmind-dkqd.onrender.com
EXPRESS_URL=https://gridmind-dkqd.onrender.com

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI / VERTEX AI CREDENTIALS (fastapi/.env)
# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) Project ID configured with Vertex AI / Gemini API
PROJECT_ID=sample-gcp-project-id-123456

# Google Cloud Region where Gemini model endpoints are provisioned
GEMINI_LOCATION=us-central1

# Google Gemini Foundation Model for Project Extraction & Conflict Synthesis
# Options: gemini-2.5-flash | gemini-2.5-flash-lite | gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini API Key if using Google AI Studio instead of GCP Vertex AI ADC
GEMINI_API_KEY=AIzaSyFakeSampleKeyForGoogleGeminiApi1234567890

# ------------------------------------------------------------------------------
# 4. FIREWORKS AI (LANGCHAIN BACKUP & RESILIENT FAILOVER) (fastapi/.env)
# ------------------------------------------------------------------------------
# Fireworks AI API Key used when Gemini experiences 429 quota limits or rate limiting
# Sign up and obtain key at: https://fireworks.ai
FIREWORKS_API_KEY=fw_sample_fireworks_api_key_xxxxxxxxxxxxxxxxxxxxxxxx

# Fireworks AI Hosted Model Identifier (used with LangChain ChatFireworks)
# Recommended: accounts/fireworks/models/minimax-m3 or accounts/fireworks/models/deepseek-v3
FIREWORKS_MODEL=accounts/fireworks/models/minimax-m3

# ------------------------------------------------------------------------------
# 5. FRONTEND VITE CLIENT (frontend/.env)
# ------------------------------------------------------------------------------
# Base URL for the Express.js Backend API (proxied via Vite during local dev or Render API)
# Local default: http://localhost:3001 | Production Render: https://gridmind-dkqd.onrender.com/api
VITE_API_URL=https://gridmind-dkqd.onrender.com/api

# Direct Base URL for the FastAPI AI Service (if direct telemetry polling is needed)
# Local default: http://localhost:8000 | Production Render: https://gridmind-1-idck.onrender.com
VITE_FASTAPI_URL=https://gridmind-1-idck.onrender.com
